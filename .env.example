# Copy this file to .env.local and fill in your own values. Never commit .env.local.
LITELLM_BASE_URL=https://<gateway address from organizers>/v1
LITELLM_API_KEY=sk-your-own-key
LITELLM_MODEL=claude-sonnet

# Optional but recommended: a GitHub token with NO scopes (public read only).
# Without it, GitHub allows only 60 requests/hour per IP.
GITHUB_TOKEN=

# Optional: if set, visitors must enter this passcode to run the agents (protects your key budget).
APP_PASSCODE=
